# Runtime
# Docker 本地启动固定由 Doppler nebula-api/dev_personal 注入；本文件只记录变量契约。
APP_ENV=development
HTTP_ADDRESS=:8080
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgres://nebula:change_me@localhost:5432/nebula?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Control-plane sessions
JWT_SIGNING_KEY=replace_with_at_least_32_random_bytes_not_a_short_label
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168
AUTH_STATE_HASH_PEPPER=replace_with_at_least_32_random_bytes_not_a_short_label

# Secret protection
API_KEY_HASH_PEPPER=replace_with_at_least_32_random_bytes_not_a_short_label
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace_with_32_random_bytes_base64

# First teacher bootstrap. These values are consumed only when no teacher exists.
BOOTSTRAP_TEACHER_NAME=Platform Teacher
BOOTSTRAP_TEACHER_EMAIL=teacher@example.com
BOOTSTRAP_TEACHER_PASSWORD=replace_with_a_strong_initial_password

# Optional fixed student and mentor test accounts. Configure each NAME/EMAIL/PASSWORD triplet together.
TEST_STUDENT_1_NAME=
TEST_STUDENT_1_EMAIL=
TEST_STUDENT_1_PASSWORD=
TEST_STUDENT_2_NAME=
TEST_STUDENT_2_EMAIL=
TEST_STUDENT_2_PASSWORD=
TEST_STUDENT_3_NAME=
TEST_STUDENT_3_EMAIL=
TEST_STUDENT_3_PASSWORD=
TEST_MENTOR_1_NAME=
TEST_MENTOR_1_EMAIL=
TEST_MENTOR_1_PASSWORD=
TEST_MENTOR_2_NAME=
TEST_MENTOR_2_EMAIL=
TEST_MENTOR_2_PASSWORD=
TEST_MENTOR_3_NAME=
TEST_MENTOR_3_EMAIL=
TEST_MENTOR_3_PASSWORD=

# SMTP and email verification (one sender account can email any registrant's address)
# SMTP_MODE=log writes codes to server logs; use smtp in production
# EXPOSE_VERIFICATION_CODE_IN_RESPONSE=true only with SMTP_MODE=log (shows code on register page for demos)
SMTP_MODE=smtp
EXPOSE_VERIFICATION_CODE_IN_RESPONSE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Nebula API
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=30

# Lab/production on this server: reuse nebula-ai console-api sender (see NebulaCloud/nebula-ai/current/.env)
#   NEBULA_SMTP_HOST     → SMTP_HOST
#   NEBULA_SMTP_PORT     → SMTP_PORT   (465 → SMTP_TLS_MODE=tls)
#   NEBULA_SMTP_USER     → SMTP_USER
#   NEBULA_SMTP_PASSWORD → SMTP_PASS
#   NEBULA_SMTP_FROM     → SMTP_FROM
#   NEBULA_SMTP_TIMEOUT  → SMTP_TIMEOUT_SECONDS
#
# --- Real SMTP recipes (industry pattern: ONE sender → ANY student mailbox) ---
# Security on our side already matches common OTP practice: 6-digit code, Redis hash,
# purpose-bound (student_registration), TTL + cooldown + attempt lockout (see auth.go).
#
# QQ mailbox (small lab; not bulk production): enable SMTP + 授权码 in QQ mail settings.
#   SMTP_MODE=smtp
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=587
#   SMTP_TLS_MODE=starttls
#   SMTP_USER=yourname@qq.com
#   SMTP_PASS=<16-char 授权码, not QQ login password>
#   SMTP_FROM=yourname@qq.com   # must match SMTP_USER (QQ rejects mismatched From)
#
# Alibaba Cloud Direct Mail (recommended CN production): create 发信地址 + SMTP password.
#   SMTP_MODE=smtp
#   SMTP_HOST=smtpdm.aliyun.com
#   SMTP_PORT=465
#   SMTP_TLS_MODE=tls
#   SMTP_USER=noreply@your-verified-domain.com
#   SMTP_PASS=<console SMTP password>
#   SMTP_FROM=noreply@your-verified-domain.com
# Docs: https://help.aliyun.com/zh/direct-mail/user-guide/send-emails-using-smtp
#
# SendGrid / Resend: prefer HTTP API at scale; our stack uses SMTP today (smtp.sendgrid.net:587, user=apikey).

EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_SEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_LOCKOUT_MINUTES=15
TEACHER_INVITATION_TTL_HOURS=24

# Redis Streams-backed authenticated SSE notifications
SSE_STREAM_MAX_LENGTH=1000
SSE_HEARTBEAT_SECONDS=15

# Optional outbound proxy for Docker backend (新增供应商 / 网关访问境外上游).
# compose.local.yaml starts proxy-relay (172.30.10.1:17890 -> host Clash 127.0.0.1:7890).
# HTTP_PROXY=http://172.30.10.1:17890
# HTTPS_PROXY=http://172.30.10.1:17890
# NO_PROXY=127.0.0.1,localhost,postgres,redis,172.30.10.1
# LOCAL_PROXY_TARGET_PORT=7890   # if Clash uses another port

# 学校后端可选预配置。在服务器的私密运行时环境注入 BEICHEN_CHANNELS_JSON
# 及学校北辰普通账号的 BEICHEN_WEB_EMAIL、BEICHEN_WEB_PASSWORD。
# 数组四项的 channel 分别为 Gemini、GM1、G3、CC1。
# 每项提供 api_key。后台使用本账号的官网记录核实各 Key 和分组的数字 ID。
# 学校 GitHub 自动部署使用学校公钥加密的配置文件。准备密文见 scripts/seal-beichen.ps1。
# scripts/compose-local.sh 用 Bash 加载配置，JSON 需按 Shell 字面量正确引用。
# 已用 BEICHEN_PANEL_TOKEN、BEICHEN_PANEL_GROUPS 的部署可继续使用原配置。
# 定时探活默认每小时运行。设为 false 后仍可由教师手动探活。
BEICHEN_PROBES_ENABLED=true

# 校方开通受管远程应用后，填入指定教师的校内用户 UUID 及固定 HTTPS 入口。
# 工作区使用独立主机名，由校方自行鉴权。地址不带登录票据、查询参数或片段。
LAB_BEICHEN_WORKSPACE_TEACHER_ID=
LAB_BEICHEN_WORKSPACE_URL=

# Gateway transport limits. These are global transport settings, not provider fields.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_RESPONSE_HEADER_TIMEOUT_SECONDS=60
GATEWAY_MAX_REQUEST_BYTES=104857600
GATEWAY_RESOURCE_ROUTE_TTL_HOURS=24

# Production-only Matrix model catalog sync. Local Compose does not start the sync worker.
# Provider catalog worker uses DATABASE_URL and PROVIDER_CREDENTIAL_ENCRYPTION_KEY from backend env.
